{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "claudesimplechatapp",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "claudesimplechatapp"
  },
  "runtimes": [
    {
      "name": "claude_simple_chatapp",
      "build": "Container",
      "entrypoint": "server/runtime-server.ts",
      "codeLocation": "./",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_y6IxvEZFu/.well-known/openid-configuration",
          "allowedAudience": [
            "hb2vc71vu3204tskglbf2vovl"
          ]
        }
      },
      "requestHeaderAllowlist": [
        "Authorization"
      ],
      "memory": "claude_simple_chatapp_mem"
    }
  ],
  "memories": [
    {
      "name": "claude_simple_chatapp_mem",
      "eventExpiryDuration": 90,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaces": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaces": [
            "/users/{actorId}/preferences"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "namespaces": [
            "/summaries/{actorId}/{sessionId}"
          ]
        },
        {
          "type": "EPISODIC",
          "namespaces": [
            "/episodes/{actorId}/{sessionId}"
          ],
          "reflectionNamespaces": [
            "/episodes/{actorId}"
          ]
        }
      ]
    }
  ],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": []
}